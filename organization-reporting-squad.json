{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>SonarSource/renovate-config"
    ],
    "timezone": "US/Central",
    "rebaseWhen": "conflicted",
    "schedule": [
        "* 7-15 * * 1"
    ],
    "enabledManagers": [
        "maven",
        "gradle",
        "gradle-wrapper",
        "poetry",
        "pipenv"
    ],
    "dependencyDashboard": true,
    "configMigration": true,
    "addLabels": [
        "dependencies"
    ],
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "draftPR": false,
    "packageRules": [
        {
            "description": "SC-62895: JFrog 6.0.5 breaks publishing individual Gradle modules. Skip this version until the upstream regression is fixed: https://github.com/jfrog/artifactory-gradle-plugin/issues/175",
            "matchPackageNames": [
                "com.jfrog.artifactory:com.jfrog.artifactory.gradle.plugin"
            ],
            "allowedVersions": "!/^6\\.0\\.5$/"
        },
        {
            "matchPackageNames": [
                "org.openapitools:openapi-generator-gradle-plugin",
                "com.sonarsource.sca:*",
                "com.sonarsource.sonarqube:*",
                "com.sonarsource.sonarcloud*",
                "org.sonarsource.api.plugin:sonar-plugin-api",
                "com.sonarsource.pdfreport:*",
                "org.sonarsource.compliancereports:*",
                "com.sonarsource.sonarcloud:compliance-reports-metadata"
            ],
            "enabled": false
        },
        {
            "matchPackageNames": [
                "certifi"
            ],
            "versioning": "semver"
        },
        {
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        },
        {
            "groupName": "Java dependencies",
            "groupSlug": "java-deps",
            "matchManagers": [
                "maven",
                "gradle",
                "gradle-wrapper"
            ],
            "separateMinorPatch": false,
            "automerge": false
        },
        {
            "groupName": "Python dependencies",
            "groupSlug": "python-deps",
            "matchManagers": [
                "poetry",
                "pipenv"
            ],
            "separateMinorPatch": false,
            "automerge": false
        }
    ]
}
